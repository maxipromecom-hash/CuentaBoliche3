name: Compilar Control Stock Boliche V3

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Instalar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Instalar dependencias
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements.txt
          python -m pip install pyinstaller

      - name: Compilar
        shell: pwsh
        run: |
          python -m PyInstaller `
            --noconfirm `
            --windowed `
            --onedir `
            --clean `
            --name ControlStockBoliche `
            --paths . `
            --hidden-import customtkinter `
            --hidden-import src.app `
            --hidden-import src.database `
            --hidden-import src.reports `
            main.py

      - name: Comprimir
        shell: pwsh
        run: |
          Compress-Archive `
            -Path dist/ControlStockBoliche/* `
            -DestinationPath ControlStockBoliche-Windows.zip

      - name: Subir aplicación
        uses: actions/upload-artifact@v4
        with:
          name: ControlStockBoliche-Windows
          path: ControlStockBoliche-Windows.zip
